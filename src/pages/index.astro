---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import About from "../components/About.astro";
---

<BaseLayout title="Home">
  <section class="grid min-h-screen place-items-center px-4 text-center">
    <div id="hero-content">
      <h1 class="text-[clamp(4rem,20vw,18rem)] leading-none tracking-tight mix-blend-difference">
        Logi0
      </h1>
      <p class="mt-8 text-lg opacity-80">Freelance developer</p>

      <div class="mt-8 flex justify-center gap-3">
        <a
          href="#about"
          class="border border-white/40 px-6 py-2 transition duration-500 hover:bg-white hover:text-black bg-black"
        >
          About
        </a>
        <a
          href="https://www.behance.net/gallery/256943481/Rich-Of-Pain"
          class="border px-6 py-2 transition duration-500 hover:bg-white hover:text-black bg-black"
        >
          Feature Project
        </a>

        <a
          href="#contact-form"
          class="border border-white/40 px-6 py-2 transition duration-500 hover:bg-white hover:text-black bg-black"
        >
          Contact
        </a>
      </div>

      <a
        href="#contact-form"
        class="mt-6 inline-flex items-center gap-2 text-sm uppercase tracking-wider opacity-80 transition duration-300 hover:opacity-100"
      >
        <span class="relative flex size-3">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex size-3 rounded-full bg-green-500"></span>
        </span>
        Now available (Hybrid/Remote)
      </a>
    </div>
  </section>
  <section id="about" class="min-h-[60vh]">
    <div class="w-full justify-center items-center flex">
      <About />
    </div>
  </section>
  <section id="contact" class="grid h-dvh place-items-center px-4">
    <div class="w-full justify-center items-center flex p-5">
      <ContactForm />
    </div>
  </section>
</BaseLayout>
